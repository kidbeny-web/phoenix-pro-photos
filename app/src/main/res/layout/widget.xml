<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="34sp" android:text="⛅" />
        <TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textSize="36sp" android:textColor="@color/widget_text"
            android:fontFamily="sans-serif-light" android:text="--°" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/w_city" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/widget_text"
                android:singleLine="true" android:ellipsize="end" android:text="Phoenix Pro Météo" />
            <TextView android:id="@+id/w_desc" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/widget_accent" android:singleLine="true"
                android:ellipsize="end" android:text="Appuie pour charger" />
            <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_sub" android:singleLine="true"
                android:ellipsize="end" android:text="" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/w_days" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/d0_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_sub" android:singleLine="true" android:text="—" />
            <TextView android:id="@+id/d0_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="18sp" android:text="☁" />
            <TextView android:id="@+id/d0_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_text" android:singleLine="true" android:text="" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/d1_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_sub" android:singleLine="true" android:text="—" />
            <TextView android:id="@+id/d1_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="18sp" android:text="☁" />
            <TextView android:id="@+id/d1_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_text" android:singleLine="true" android:text="" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/d2_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_sub" android:singleLine="true" android:text="—" />
            <TextView android:id="@+id/d2_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="18sp" android:text="☁" />
            <TextView android:id="@+id/d2_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_text" android:singleLine="true" android:text="" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/d3_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_sub" android:singleLine="true" android:text="—" />
            <TextView android:id="@+id/d3_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="18sp" android:text="☁" />
            <TextView android:id="@+id/d3_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_text" android:singleLine="true" android:text="" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/d4_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_sub" android:singleLine="true" android:text="—" />
            <TextView android:id="@+id/d4_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="18sp" android:text="☁" />
            <TextView android:id="@+id/d4_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_text" android:singleLine="true" android:text="" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
